@prefix oakex: <https://w3id.org/eska/example/oak-backend-independence#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/eska/example/oak-backend-independence>
    a owl:Ontology ;
    rdfs:label "ESKA OAK backend-independence fixture"@en .

oakex:Root
    a owl:Class ;
    rdfs:label "Root concept"@en .

oakex:Child
    a owl:Class ;
    rdfs:subClassOf oakex:Root ;
    rdfs:label "Child concept"@en .
