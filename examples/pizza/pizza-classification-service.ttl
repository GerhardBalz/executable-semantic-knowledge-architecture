@prefix cap: <urn:eska:example:pizza:capability:> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eska: <urn:eska:core:> .
@prefix svc: <urn:eska:example:pizza:service:> .

svc:PizzaClassificationService
    a eska:KnowledgeService ;
    dcterms:title "Pizza Classification Knowledge Service"@en ;
    dcterms:description "HTTP access to the bounded PizzaClassificationCapability. The service exposes classifications already produced by OWL semantic reasoning; it does not encode an independent classification rule."@en ;
    dcterms:identifier "examples/pizza/service.py" ;
    eska:exposesCapability cap:PizzaClassificationCapability ;
    eska:hasOperation svc:ClassifyPizzaClassOperation .

svc:ClassifyPizzaClassOperation
    a eska:ServiceOperation ;
    dcterms:title "Classify Pizza class"@en ;
    dcterms:description "Operational realization of PizzaClassificationCapability. Semantic input/output/relation are taken from the Capability; HTTP/JSON representation details are delegated to the access binding."@en ;
    eska:realizesCapability cap:PizzaClassificationCapability ;
    eska:hasAccessBinding svc:ClassifyPizzaClassHTTPBinding .

svc:ClassifyPizzaClassHTTPBinding
    a eska:HTTPAccessBinding ;
    eska:httpMethod "POST" ;
    eska:path "/classify" ;
    eska:mediaType "application/json" ;
    eska:requestField "class" ;
    eska:resultField "classifications" ;
    eska:relationField "relation" ;
    eska:capabilityField "capability" .
