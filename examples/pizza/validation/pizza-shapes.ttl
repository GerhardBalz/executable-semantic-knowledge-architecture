@prefix ex: <urn:eska:example:pizza:data:> .
@prefix pizza: <http://www.co-ode.org/ontologies/pizza/pizza.owl#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

ex:PizzaShape
    a sh:NodeShape ;
    sh:targetClass pizza:Pizza ;
    sh:property [
        sh:path pizza:hasBase ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:class pizza:PizzaBase ;
        sh:message "A Pizza data node must have exactly one PizzaBase."@en
    ] ;
    sh:property [
        sh:path pizza:hasTopping ;
        sh:minCount 1 ;
        sh:class pizza:PizzaTopping ;
        sh:message "A Pizza data node must have at least one PizzaTopping."@en
    ] .
