PREFIX eska: <urn:eska:core:>
PREFIX cap: <urn:eska:example:pizza:capability:>
PREFIX svc: <urn:eska:example:pizza:service:>
PREFIX agent: <urn:eska:example:pizza:agent:>
PREFIX val: <urn:eska:example:pizza:validation:>
PREFIX valsvc: <urn:eska:example:pizza:validation-service:>
PREFIX valagent: <urn:eska:example:pizza:validation-agent:>

# ROBOT verify treats returned rows as violations.
# Classification and validation must share the same semantic Service/Operation/AccessBinding pattern.
SELECT ?mode ?capability
WHERE {
  VALUES (?mode ?capability ?service ?operation ?binding ?knowledgeAgent ?discovery) {
    ("classification" cap:PizzaClassificationCapability svc:PizzaClassificationService svc:ClassifyPizzaClassOperation svc:ClassifyPizzaClassHTTPBinding agent:PizzaKnowledgeAgent agent:PizzaClassificationServiceDiscovery)
    ("validation" val:PizzaValidationCapability valsvc:PizzaValidationService valsvc:ValidatePizzaDataOperation valsvc:ValidatePizzaDataHTTPBinding valagent:PizzaValidationAgent valagent:PizzaValidationServiceDiscovery)
  }

  FILTER NOT EXISTS {
    ?service
        a eska:KnowledgeService ;
        eska:exposesCapability ?capability ;
        eska:hasOperation ?operation .

    ?operation
        a eska:ServiceOperation ;
        eska:realizesCapability ?capability ;
        eska:hasAccessBinding ?binding .

    ?capability
        eska:inputType ?inputType ;
        eska:outputType ?outputType ;
        eska:producesRelation ?relation ;
        eska:requiresCondition ?condition .

    ?binding
        a eska:HTTPAccessBinding ;
        eska:httpMethod ?method ;
        eska:path ?path ;
        eska:mediaType ?mediaType ;
        eska:requestField ?requestField ;
        eska:resultField ?resultField ;
        eska:relationField ?relationField ;
        eska:capabilityField ?capabilityField .

    ?knowledgeAgent
        a eska:KnowledgeAgent ;
        eska:targetsCapability ?capability ;
        eska:usesDiscoveryArtifact ?discovery .

    ?discovery a eska:DiscoveryArtifact .
  }
}
