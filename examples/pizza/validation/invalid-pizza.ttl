@prefix ex: <urn:eska:example:pizza:data:> .
@prefix pizza: <http://www.co-ode.org/ontologies/pizza/pizza.owl#> .

ex:invalidPizza
    a pizza:Pizza ;
    pizza:hasBase ex:thinBase, ex:deepPanBase ;
    pizza:hasTopping ex:mozzarella .

ex:thinBase a pizza:PizzaBase .
ex:deepPanBase a pizza:PizzaBase .
ex:mozzarella a pizza:PizzaTopping .
