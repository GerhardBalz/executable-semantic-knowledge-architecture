PREFIX eska: <urn:eska:core:>
PREFIX cap: <urn:eska:example:pizza:capability:>
PREFIX run: <urn:eska:example:pizza:>
PREFIX val: <urn:eska:example:pizza:validation:>
PREFIX rul: <urn:eska:example:pizza:rule:>
PREFIX dec: <urn:eska:example:pizza:decision:>
PREFIX cal: <urn:eska:example:pizza:calculation:>

# ROBOT verify treats returned rows as violations.
# Runtime executions from different semantic modes must share the same core pattern.
SELECT ?mode ?execution
WHERE {
  VALUES (?mode ?execution ?capability ?result ?verification) {
    ("reasoning" run:spicy-pizza-reasoning cap:PizzaClassificationCapability run:american-hot-spicy-inference run:spicy-pizza-verification)
    ("validation-conform" val:valid-pizza-validation val:PizzaValidationCapability val:ValidPizzaValidationReport val:valid-pizza-validation-verification)
    ("validation-nonconform" val:invalid-pizza-validation val:PizzaValidationCapability val:InvalidPizzaValidationReport val:invalid-pizza-validation-verification)
    ("rule" rul:PizzaRuleEvaluationExecution rul:PizzaRuleEvaluationCapability rul:MeatyPizzaWarningResult rul:PizzaRuleEvaluationVerification)
    ("decision-meat" dec:meatyPizza-decision-execution dec:PizzaDietarySuitabilityCapability dec:meatyPizza-decision-result dec:meatyPizza-decision-verification)
    ("decision-fish" dec:fishPizza-decision-execution dec:PizzaDietarySuitabilityCapability dec:fishPizza-decision-result dec:fishPizza-decision-verification)
    ("decision-vegetarian" dec:vegetarianPizza-decision-execution dec:PizzaDietarySuitabilityCapability dec:vegetarianPizza-decision-result dec:vegetarianPizza-decision-verification)
    ("calculation-small" cal:smallPizza-calculation-execution cal:PizzaAreaCalculationCapability cal:smallPizza-calculation-result cal:smallPizza-calculation-verification)
    ("calculation-medium" cal:mediumPizza-calculation-execution cal:PizzaAreaCalculationCapability cal:mediumPizza-calculation-result cal:mediumPizza-calculation-verification)
    ("calculation-large" cal:largePizza-calculation-execution cal:PizzaAreaCalculationCapability cal:largePizza-calculation-result cal:largePizza-calculation-verification)
  }

  FILTER NOT EXISTS {
    ?execution
        a eska:Execution ;
        eska:executesCapability ?capability ;
        eska:usesSemanticModel ?semanticModel ;
        eska:usesExecutableArtifact ?executableArtifact ;
        eska:generatesResult ?result .

    ?result a eska:Result .

    ?verification
        a eska:Verification ;
        eska:verifiesExecution ?execution ;
        eska:verifiesResult ?result .
  }
}
