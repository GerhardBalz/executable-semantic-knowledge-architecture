@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eska: <https://w3id.org/eska#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix prov: <http://www.w3.org/ns/prov#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://w3id.org/eska/model/deployment>
    a owl:Ontology ;
    dcterms:title "ESKA deployment binding model"@en ;
    dcterms:description "A deliberately small extension for binding a stable Knowledge Service contract to concrete runtime deployments without embedding environment-specific locations in semantic Service or Capability contracts."@en ;
    dcterms:requires <https://w3id.org/eska/model/service> ;
    owl:versionIRI <https://w3id.org/eska/model/deployment/0.1.0> ;
    owl:versionInfo "0.1.0" .

eska:ServiceDeployment
    a owl:Class ;
    rdfs:subClassOf prov:Entity ;
    rdfs:label "Service Deployment"@en ;
    skos:definition "A concrete runtime deployment of a Knowledge Service in a particular deployment environment. The deployment is distinct from the stable semantic Service contract it realizes."@en .

eska:DeploymentEnvironment
    a owl:Class ;
    rdfs:label "Deployment Environment"@en ;
    skos:definition "A named runtime environment in which one or more Service Deployments are available, such as a local, test, staging, or production environment."@en .

eska:DeploymentBinding
    a owl:Class ;
    rdfs:label "Deployment Binding"@en ;
    skos:definition "A runtime location binding used to reach a concrete Service Deployment. It complements, but does not replace, a Service Operation Access Binding."@en .

eska:HTTPDeploymentBinding
    a owl:Class ;
    rdfs:subClassOf eska:DeploymentBinding ;
    rdfs:label "HTTP Deployment Binding"@en ;
    skos:definition "A Deployment Binding that supplies the runtime HTTP base URL which is combined with a contract-relative path from an HTTP Access Binding."@en .

eska:deploysService
    a owl:ObjectProperty ;
    rdfs:label "deploys service"@en ;
    skos:definition "Identifies the stable Knowledge Service contract realized by a concrete Service Deployment."@en ;
    rdfs:domain eska:ServiceDeployment ;
    rdfs:range eska:KnowledgeService .

eska:inEnvironment
    a owl:ObjectProperty ;
    rdfs:label "in environment"@en ;
    skos:definition "Identifies the Deployment Environment in which a Service Deployment is available."@en ;
    rdfs:domain eska:ServiceDeployment ;
    rdfs:range eska:DeploymentEnvironment .

eska:hasDeploymentBinding
    a owl:ObjectProperty ;
    rdfs:label "has deployment binding"@en ;
    skos:definition "Associates a Service Deployment with the runtime location binding used to reach it."@en ;
    rdfs:domain eska:ServiceDeployment ;
    rdfs:range eska:DeploymentBinding .

eska:baseURL
    a owl:DatatypeProperty ;
    rdfs:label "base URL"@en ;
    skos:definition "Runtime HTTP base URL for a concrete deployment. Contract-relative operation paths remain in the HTTP Access Binding."@en ;
    rdfs:domain eska:HTTPDeploymentBinding ;
    rdfs:range xsd:anyURI .
