@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eska: <https://w3id.org/eska#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/eska/model/agent>
    a owl:Ontology ;
    dcterms:title "ESKA agent model"@en ;
    dcterms:description "A deliberately small extension containing terms needed to describe and test Knowledge Agents, semantic service discovery, and semantically typed invocation adaptation."@en ;
    dcterms:requires <https://w3id.org/eska/model/core> ;
    owl:versionIRI <https://w3id.org/eska/model/agent/0.3.0> ;
    owl:versionInfo "0.3.0" .

eska:KnowledgeAgent
    a owl:Class ;
    rdfs:label "Knowledge Agent"@en ;
    skos:definition "A software agent that can use machine-interpretable ESKA contracts to discover and invoke knowledge capabilities and interpret their semantic results."@en .

eska:DiscoveryArtifact
    a owl:Class ;
    rdfs:label "Discovery Artifact"@en ;
    skos:definition "An executable or queryable artifact used by an agent to discover an operational realization of a semantic capability."@en .

eska:SemanticInvocationAdapter
    a owl:Class ;
    rdfs:label "Semantic Invocation Adapter"@en ;
    skos:definition "An agent-side executable adapter that encodes a semantically typed input for a discovered access contract and interprets the returned result according to the discovered Capability output type and relation."@en .

eska:targetsCapability
    a owl:ObjectProperty ;
    rdfs:label "targets capability"@en ;
    rdfs:domain eska:KnowledgeAgent ;
    rdfs:range eska:SemanticCapability .

eska:usesDiscoveryArtifact
    a owl:ObjectProperty ;
    rdfs:label "uses discovery artifact"@en ;
    rdfs:domain eska:KnowledgeAgent ;
    rdfs:range eska:DiscoveryArtifact .

eska:usesInvocationAdapter
    a owl:ObjectProperty ;
    rdfs:label "uses invocation adapter"@en ;
    rdfs:domain eska:KnowledgeAgent ;
    rdfs:range eska:SemanticInvocationAdapter .

eska:supportsInputType
    a owl:ObjectProperty ;
    rdfs:label "supports input type"@en ;
    rdfs:domain eska:SemanticInvocationAdapter ;
    skos:definition "Identifies a semantic input type that an invocation adapter can encode for service access."@en .

eska:supportsOutputType
    a owl:ObjectProperty ;
    rdfs:label "supports output type"@en ;
    rdfs:domain eska:SemanticInvocationAdapter ;
    skos:definition "Identifies a semantic output type that an invocation adapter can interpret from a service result."@en .

eska:supportsRelation
    a owl:ObjectProperty ;
    rdfs:label "supports relation"@en ;
    rdfs:domain eska:SemanticInvocationAdapter ;
    skos:definition "Identifies a semantic result relation that an invocation adapter can preserve and interpret."@en .
