@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eska: <https://w3id.org/eska#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://w3id.org/eska/model/capability>
    a owl:Ontology ;
    dcterms:title "ESKA capability extension"@en ;
    dcterms:description "Capability-specific terms that are useful for examples but have not yet been promoted into the ESKA core model."@en ;
    dcterms:requires <https://w3id.org/eska/model/core> ;
    owl:versionIRI <https://w3id.org/eska/model/capability/0.2.0> ;
    owl:versionInfo "0.2.0" .

eska:exampleInput
    a owl:ObjectProperty ;
    rdfs:label "example input"@en .

eska:exampleOutput
    a owl:ObjectProperty ;
    rdfs:label "example output"@en .
