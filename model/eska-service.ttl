@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eska: <https://w3id.org/eska#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://w3id.org/eska/model/service>
    a owl:Ontology ;
    dcterms:title "ESKA service model"@en ;
    dcterms:description "A deliberately small extension containing stable Knowledge Service semantics plus separate access-binding terms."@en ;
    dcterms:requires <https://w3id.org/eska/model/core> ;
    owl:versionIRI <https://w3id.org/eska/model/service/0.4.0> ;
    owl:versionInfo "0.4.0" .

eska:KnowledgeService
    a owl:Class ;
    rdfs:label "Knowledge Service"@en ;
    skos:definition "An operational interface through which one or more Semantic Capabilities can be exposed for discovery and invocation."@en .

eska:ServiceOperation
    a owl:Class ;
    rdfs:label "Service Operation"@en ;
    skos:definition "An operational realization of one Semantic Capability exposed by a Knowledge Service. Its semantic input, output, relation, and applicability are defined by the Capability; concrete access details are supplied through an Access Binding."@en .

eska:AccessBinding
    a owl:Class ;
    rdfs:label "Access Binding"@en ;
    skos:definition "A concrete transport or representation binding through which a Service Operation can be invoked."@en .

eska:HTTPAccessBinding
    a owl:Class ;
    rdfs:subClassOf eska:AccessBinding ;
    rdfs:label "HTTP Access Binding"@en ;
    skos:definition "An Access Binding that identifies an HTTP operation contract independently of a particular runtime deployment location."@en .

eska:exposesCapability
    a owl:ObjectProperty ;
    rdfs:label "exposes capability"@en ;
    rdfs:domain eska:KnowledgeService ;
    rdfs:range eska:SemanticCapability .

eska:hasOperation
    a owl:ObjectProperty ;
    rdfs:label "has operation"@en ;
    rdfs:domain eska:KnowledgeService ;
    rdfs:range eska:ServiceOperation .

eska:realizesCapability
    a owl:ObjectProperty ;
    rdfs:label "realizes capability"@en ;
    skos:definition "Identifies the Semantic Capability operationally realized by a Service Operation."@en ;
    rdfs:domain eska:ServiceOperation ;
    rdfs:range eska:SemanticCapability .

eska:hasAccessBinding
    a owl:ObjectProperty ;
    rdfs:label "has access binding"@en ;
    skos:definition "Associates a Service Operation with a concrete access contract without making that transport contract part of the Semantic Capability."@en ;
    rdfs:domain eska:ServiceOperation ;
    rdfs:range eska:AccessBinding .

eska:httpMethod
    a owl:DatatypeProperty ;
    rdfs:label "HTTP method"@en ;
    rdfs:domain eska:HTTPAccessBinding .

eska:path
    a owl:DatatypeProperty ;
    rdfs:label "path"@en ;
    rdfs:domain eska:HTTPAccessBinding ;
    skos:definition "Contract-relative HTTP path. Runtime scheme, host, and port are deployment bindings and remain separate."@en .

eska:mediaType
    a owl:DatatypeProperty ;
    rdfs:label "media type"@en ;
    rdfs:domain eska:AccessBinding ;
    skos:definition "Media type of the access representation envelope. It does not replace the Semantic Capability output type or determine how the semantic result must be interpreted."@en .

eska:requestField
    a owl:DatatypeProperty ;
    rdfs:label "request field"@en ;
    rdfs:domain eska:AccessBinding ;
    skos:definition "Representation field that carries the semantically typed service input."@en .

eska:resultField
    a owl:DatatypeProperty ;
    rdfs:label "result field"@en ;
    rdfs:domain eska:AccessBinding ;
    skos:definition "Representation field that carries the semantically typed service result. The field location is an access concern; result meaning comes from the Capability output type and produced relation."@en .

eska:relationField
    a owl:DatatypeProperty ;
    rdfs:label "relation field"@en ;
    rdfs:domain eska:AccessBinding ;
    skos:definition "Representation field that identifies the semantic relation expressed by the result."@en .

eska:capabilityField
    a owl:DatatypeProperty ;
    rdfs:label "capability field"@en ;
    rdfs:domain eska:AccessBinding ;
    skos:definition "Representation field that identifies the Semantic Capability under which the result was produced."@en .
