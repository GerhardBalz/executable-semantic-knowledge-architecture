@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix eska: <urn:eska:core:> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<urn:eska:model:service>
    a owl:Ontology ;
    dcterms:title "ESKA service model"@en ;
    dcterms:description "A deliberately small, provisional semantic model containing only the terms needed to describe and test Knowledge Services and their operations."@en ;
    owl:versionInfo "0.2-provisional" .

eska:KnowledgeService
    a owl:Class ;
    rdfs:label "Knowledge Service"@en ;
    skos:definition "An operational interface through which knowledge or a Semantic Capability can be discovered, queried, reasoned over, validated, evaluated, transformed, explained, or acted upon."@en .

eska:ServiceOperation
    a owl:Class ;
    rdfs:label "Service Operation"@en ;
    skos:definition "A bounded operation exposed by a Knowledge Service through a concrete access mechanism."@en .

eska:exposesCapability
    a owl:ObjectProperty ;
    rdfs:label "exposes capability"@en ;
    rdfs:domain eska:KnowledgeService ;
    rdfs:range eska:SemanticCapability .

eska:hasOperation
    a owl:ObjectProperty ;
    rdfs:label "has operation"@en ;
    rdfs:domain eska:KnowledgeService ;
    rdfs:range eska:ServiceOperation .

eska:httpMethod
    a owl:DatatypeProperty ;
    rdfs:label "HTTP method"@en .

eska:path
    a owl:DatatypeProperty ;
    rdfs:label "path"@en .

eska:mediaType
    a owl:DatatypeProperty ;
    rdfs:label "media type"@en .

eska:requestField
    a owl:DatatypeProperty ;
    rdfs:label "request field"@en ;
    skos:definition "Representation field that carries the semantically typed service input."@en .

eska:resultField
    a owl:DatatypeProperty ;
    rdfs:label "result field"@en ;
    skos:definition "Representation field that carries the semantically typed service result."@en .

eska:relationField
    a owl:DatatypeProperty ;
    rdfs:label "relation field"@en ;
    skos:definition "Representation field that identifies the semantic relation expressed by a result."@en .

eska:capabilityField
    a owl:DatatypeProperty ;
    rdfs:label "capability field"@en ;
    skos:definition "Representation field that identifies the Semantic Capability under which the result was produced."@en .
